{
  "name": "assistant-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Headless, provider-independent composition runtime for assistant subsystems.",
  "type": "module",
  "bin": { "assistant-runtime": "./dist/cli/main.js" },
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": { "@types/node": "^22.13.10", "tsx": "^4.19.3", "typescript": "^5.8.2" }
}
